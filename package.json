{
  "name": "glass-ui-css",
  "version": "1.0.0",
  "description": "Glass UI: a glass look for the web. One stylesheet, one small script, plain HTML.",
  "keywords": [
    "glass",
    "ui",
    "css",
    "ui-kit",
    "glassmorphism",
    "vanilla-js",
    "design-system"
  ],
  "license": "MIT",
  "author": "San",
  "main": "glass-ui.js",
  "style": "glass-ui.css",
  "exports": {
    ".": {
      "style": "./glass-ui.css",
      "default": "./glass-ui.js"
    },
    "./*": "./*"
  },
  "sideEffects": true,
  "files": [
    "glass-ui.css",
    "glass-ui.min.css",
    "glass-ui.js",
    "glass-ui.min.js",
    "glass-morph.css",
    "glass-morph.min.css",
    "glass-morph.js",
    "glass-morph.min.js",
    "glass-icons.css",
    "glass-icons.min.css",
    "glass-ui-light.css",
    "glass-ui-light.min.css",
    "glass-ui-liquid.js",
    "glass-ui-liquid.min.js",
    "glass-appearance.css",
    "glass-appearance.min.css",
    "glass-appearance.js",
    "glass-appearance.min.js"
  ],
  "scripts": {
    "test": "node --test test/smoke.test.mjs test/spacing.test.mjs test/address.test.mjs test/page.test.mjs"
  },
  "devDependencies": {
    "@formkit/auto-animate": "0.8.2",
    "playwright": "^1.50.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}

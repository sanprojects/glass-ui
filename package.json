{
  "name": "glass-ui-css",
  "version": "1.0.0",
  "description": "Glass UI: a glass look for the web. One stylesheet, one small script, plain HTML.",
  "keywords": [
    "glass",
    "ui",
    "css",
    "ui-kit",
    "glassmorphism",
    "vanilla-js",
    "design-system"
  ],
  "license": "MIT",
  "author": "San",
  "main": "glass-ui.js",
  "style": "glass-ui.css",
  "exports": {
    ".": {
      "style": "./glass-ui.css",
      "default": "./glass-ui.js"
    },
    "./*": "./*"
  },
  "sideEffects": true,
  "files": [
    "glass-ui.css",
    "glass-ui.min.css",
    "glass-ui.js",
    "glass-ui.min.js",
    "glass-icons.css",
    "glass-icons.min.css",
    "glass-ui-light.css",
    "glass-ui-light.min.css",
    "glass-ui-liquid.js",
    "glass-ui-liquid.min.js",
    "glass-appearance.css",
    "glass-appearance.min.css",
    "glass-appearance.js",
    "glass-appearance.min.js"
  ],
  "scripts": {
    "test": "node --test test/smoke.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
